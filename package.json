{
	"name": "obsidian-gantt-plugin",
	"version": "1.0.0",
	"description": "Reviews all tasks in the vault and displays them as a dynamic, interactive Gantt chart.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",
		"gantt",
		"gantt-chart",
		"tasks",
		"project-management"
	],
	"license": "0-BSD",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"tslib": "2.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
